# Sensitive config — contains API keys, never commit
.mcp.json
.env
*.env.*
CLAUDE.local.md

# Browser sessions — private login state
_conclave/_browser_profile/

# Backup files generated by Conclave overwrite protection
**/*.bak-*

# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.pyc
.venv/

# Node / runtime caches
node_modules/
.npm-cache/
.puppeteer-cache/
.nvm/

# Build artifacts
_conclave/runtime/logs/
_build/
squads/*/output/
.vault
.linkedin_token
_export_opensource/

# Protocolo Exodus: Exclusões de Backup Primário
# Ignora arquivos de mídia pesados (preservar no Drive/HD)
references/*
!references/MAPA.md

# Ignora builds e diretórios gigantescos dentro dos ambientes (mas preserva o código dos ambientes)
ambientes/**/node_modules/
ambientes/**/dist/
ambientes/**/*.app/
ambientes/**/*.dmg
ambientes/**/build/
ambientes/**/.venv/

# Ignorar backups compactados pesados (acima de 100MB bloqueiam no GitHub)
*.zip
*.tar.gz
*.rar
